---
// 検索ボックス。候補の絞り込みは src/scripts/search.ts（検索用データは初回フォーカス時に読み込む）
import Icon from './Icon.astro';
import { url } from '../lib/url';
import { CONFIG } from '../config';

interface Props {
  placeholder: string;
  emptyText: string;
  class?: string;
  /** true で入力欄の右端にショートカットの目印（Ctrl K / ⌘K）を表示する */
  hint?: boolean;
}
const { placeholder, emptyText, class: cls, hint = false } = Astro.props;
---
<div
  class:list={['search', cls]}
  data-search
  data-index-url={url.searchIndex()}
  data-log-url={url.api('search-log')}
  data-empty-text={emptyText}
  data-limit={CONFIG.searchLimit}
>
  <Icon name="search" class="search__icon" />
  <input
    class="input"
    type="search"
    placeholder={placeholder}
    aria-label="検索"
    role="combobox"
    aria-autocomplete="list"
    aria-expanded="false"
    aria-keyshortcuts={hint ? 'Control+K Meta+K' : undefined}
    autocomplete="off"
  />
  {hint && <kbd class="search__kbd" aria-hidden="true"><span class="os-other">Ctrl K</span><span class="os-mac">⌘K</span></kbd>}
  <div class="search__dropdown" hidden></div>
</div>

<script>
  import { initSearchBoxes } from '../scripts/search';
  initSearchBoxes();
</script>
