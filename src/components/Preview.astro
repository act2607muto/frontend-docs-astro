---
// 実行結果プレビュー：sandbox 付き iframe（srcdoc）。高さは中身に合わせて src/scripts/preview.ts が調整する
// iframe は allow-scripts のみ許可（allow-same-origin は付けない）ので、親ページとは別オリジン扱いで隔離される
// JS のサンプルでは console の出力を下の「コンソール」欄に表示し、submit を扱えるよう allow-forms も許可する
import { buildSrcdoc } from '../lib/preview';
import type { CodeSet, Detail } from '../lib/data';

interface Props {
  code: CodeSet;
  preview: Detail['preview'];
}
const { code, preview } = Astro.props;
const hasJs = !!code.js;
// HTML がなく JS だけのサンプルは、画面を隠してコンソール欄だけを表示する
const consoleOnly = hasJs && !code.html;
---
<div class:list={['preview', { 'preview--console-only': consoleOnly }]} data-preview-box>
  {!(consoleOnly && !preview.note) && (
    <div class="preview__head"><span class="preview__label">ブラウザでの表示</span><span>{preview.note ?? ''}</span></div>
  )}
  <iframe
    class="preview__frame"
    title="実行結果のプレビュー"
    sandbox={hasJs ? 'allow-scripts allow-forms' : 'allow-scripts'}
    srcdoc={buildSrcdoc(code, preview.fullDocument)}
    style={`height:${preview.height || 160}px`}
    data-preview
  ></iframe>
  {hasJs && (
    <div class="console">
      <div class="console__head"><span>コンソール</span><button type="button" class="btn btn-ghost console__rerun" data-rerun>もう一度実行</button></div>
      <ol class="console__lines" aria-live="polite"><li class="console__empty">console.log() の出力がここに表示されます</li></ol>
    </div>
  )}
</div>

<script>
  import { initPreview } from '../scripts/preview';
  initPreview();
</script>
