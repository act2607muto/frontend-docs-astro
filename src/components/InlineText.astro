---
// `バッククォート` 部分をインラインコード、**アスタリスク2つ** で囲んだ部分を強調として表示する
import { segments } from '../lib/data';

interface Props {
  text: string;
}
const { text } = Astro.props;
---
{segments(text).map((s) => {
  const inner = s.code ? <code class="icode">{s.t}</code> : s.t;
  return s.strong ? <strong>{inner}</strong> : inner;
})}
