---
// rowspan / colspan の図解（3行×3列）。行・列を帯で示し、結合セルがどの帯にまたがるかを見せる
interface Props {
  kind: 'row' | 'col';
}
const { kind } = Astro.props;
const N = [1, 2, 3];
const isRow = kind === 'row';
// 結合セルが占める位置（rowspan は1列目の1〜2行目、colspan は1行目の1〜2列目）
const covered = (r: number, c: number) => (isRow ? c === 1 && r <= 2 : r === 1 && c <= 2);
// 見出し（行番号・列番号）の分だけ、データのセルを1つずらして置く
const at = (r: number, c: number) => (isRow ? `grid-row:${r};grid-column:${c + 1}` : `grid-row:${r + 1};grid-column:${c}`);
const label = isRow
  ? 'rowspan の図：上下に積み重なった1行目と2行目にまたがるため、セルは縦に伸びる'
  : 'colspan の図：左右に並んだ1列目と2列目にまたがるため、セルは横に伸びる';
---
<div class:list={['span-dg', `span-dg--${kind}`]} role="img" aria-label={label}>
  {N.map((i) => (
    <>
      <span class="span-dg__band" style={isRow ? `grid-row:${i};grid-column:2/5` : `grid-row:2/5;grid-column:${i}`}></span>
      <span class="span-dg__label" style={isRow ? `grid-row:${i};grid-column:1` : `grid-row:1;grid-column:${i}`}>
        {isRow ? `${i}行目` : `${i}列目`}<small>{isRow ? '（横一列）' : '（縦一列）'}</small>
      </span>
    </>
  ))}
  {N.flatMap((r) => N.filter((c) => !covered(r, c)).map((c) => <span class="span-dg__cell" style={at(r, c)}></span>))}
  <span class="span-dg__merged" style={isRow ? 'grid-row:1/3;grid-column:2' : 'grid-row:2;grid-column:1/3'}>
    <code>{isRow ? 'rowspan="2"' : 'colspan="2"'}</code>
    <span>{isRow ? '↓ 2つの行' : '→ 2つの列'}</span>
  </span>
</div>
