---
// 全ページ共通の <head>。テーマはちらつき前にインラインスクリプトで適用する
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';
import SearchDialog from '../components/SearchDialog.astro';

interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = 'HTMLタグ・CSSプロパティ・JavaScriptを、サンプルコードと実際の表示結果で学べる辞典・学習サイトです。',
} = Astro.props;

// GA4 は Vercel の本番デプロイだけで読み込む（プレビュー・ローカル・GitHub Pages では出力しない）
// 出力モードは static なので、VERCEL_ENV はビルド時に Node の process.env から読む
const isProd = process.env.VERCEL_ENV === 'production';
const gaMeasurementId = 'G-5PD9T9SNKN';
---
<!doctype html>
<html lang="ja">
  <head>
    {isProd && (
      <>
        <!-- Google tag (gtag.js) -->
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
        <script is:inline define:vars={{ gaMeasurementId }}>
          window.dataLayer = window.dataLayer || [];
          window.gtag = function gtag(){dataLayer.push(arguments);};
          gtag('js', new Date());

          gtag('config', gaMeasurementId);
        </script>
      </>
    )}
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script is:inline>
      // テーマをちらつき前に適用（保存値 → OS設定の順）
      (function () {
        var t; try { t = localStorage.getItem('hcg-theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
        // ショートカットの表記を Mac（⌘K）とそれ以外（Ctrl K）で切り替える
        var p = (navigator.userAgentData && navigator.userAgentData.platform) || navigator.platform || navigator.userAgent;
        document.documentElement.dataset.os = /mac|iphone|ipad/i.test(p) ? 'mac' : 'other';
        // プレビュー（iframe）からのメッセージは、受け取り側のスクリプトが読み込まれる前に届くことがあるため、先にためておく
        window.__hcgPreviewQueue = [];
        addEventListener('message', function (e) { if (window.__hcgPreviewQueue) window.__hcgPreviewQueue.push(e); });
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&display=swap" />
  </head>
  <body>
    <slot />
    <SearchDialog />
  </body>
</html>
