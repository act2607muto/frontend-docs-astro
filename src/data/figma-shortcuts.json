      { "label": "次 / 前の要素（兄弟）を選択", "mac": "Tab / Shift+Tab", "win": "Tab / Shift+Tab" },
      { "label": "グループの中の要素を直接選択", "mac": "Cmd+クリック", "win": "Ctrl+クリック" },
      { "label": "重なった下の要素を選択", "mac": "右クリック → 「レイヤーを選択」", "win": "右クリック → 「レイヤーを選択」", "note": "カーソルの下にあるレイヤーが一覧で出るので、そこから選びます。" },
