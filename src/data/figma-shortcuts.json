      { "label": "ドラッグで複製", "mac": "Opt+ドラッグ", "win": "Alt+ドラッグ", "note": "移動するときに押すと複製、サイズを変えるときに押すと中心基準になります。" },
      { "label": "要素どうしの距離を表示", "mac": "Opt+ホバー", "win": "Alt+ホバー", "note": "1つ選んだ状態で、別の要素にカーソルを乗せます。" },
      { "label": "中身を動かさずにフレームだけ変形", "mac": "Cmd+ドラッグ", "win": "Ctrl+ドラッグ" }
    ]
  },
  {
    "id": "align",
    "title": "整列",
    "en": "ALIGN",
