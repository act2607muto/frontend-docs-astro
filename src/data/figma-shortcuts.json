      { "label": "上揃え / 下揃え", "mac": "Opt+W / Opt+S", "win": "Alt+W / Alt+S" },
      { "label": "水平方向の中央揃え", "mac": "Opt+H", "win": "Alt+H" },
      { "label": "垂直方向の中央揃え", "mac": "Opt+V", "win": "Alt+V" },
      { "label": "整列して間隔をそろえる（Tidy up）", "mac": "Ctrl+Opt+T", "win": "Ctrl+Alt+T" }
    ]
  },
  {
    "id": "components",
    "title": "オートレイアウト・コンポーネント",
