      { "label": "グループ解除", "mac": "Cmd+Shift+G", "win": "Ctrl+Shift+G" },
      { "label": "選択範囲をフレームで囲む", "mac": "Cmd+Opt+G", "win": "Ctrl+Alt+G" },
      { "label": "表示 / 非表示", "mac": "Cmd+Shift+H", "win": "Ctrl+Shift+H" },
      { "label": "ロック / ロック解除", "mac": "Cmd+Shift+L", "win": "Ctrl+Shift+L" },
      { "label": "前面へ / 背面へ", "mac": "Cmd+] / Cmd+[", "win": "Ctrl+] / Ctrl+[" },
      { "label": "最前面へ / 最背面へ", "mac": "Opt+Cmd+] / Opt+Cmd+[", "win": "Ctrl+Shift+] / Ctrl+Shift+[" }
    ]
  },
  {
    "id": "transform",
    "title": "移動・サイズ変更",
    "en": "TRANSFORM",
    "desc": "キーボードでの微調整と、ドラッグ中に押すと動きが変わるキーです。",
    "items": [
      { "label": "1px ずつ移動", "mac": "矢印キー", "win": "矢印キー" },
      { "label": "10px ずつ移動", "mac": "Shift+矢印キー", "win": "Shift+矢印キー" },
      { "label": "縦横比を保って変形", "mac": "Shift+ドラッグ", "win": "Shift+ドラッグ" },
