  },
  {
    "id": "select",
    "title": "選択・レイヤー",
    "en": "SELECTION & LAYERS",
    "desc": "入れ子になったレイヤーの選択や、グループ化・重なり順の変更に使います。",
    "items": [
      { "label": "すべて選択", "mac": "Cmd+A", "win": "Ctrl+A" },
      { "label": "子要素を選択", "mac": "Enter", "win": "Enter" },
