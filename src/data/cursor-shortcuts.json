[
  {
    "id": "general",
    "title": "一般",
    "en": "GENERAL",
    "desc": "Agent パネルや設定、モードの切り替えなど、Cursor 全体で使う操作です。",
    "items": [
      { "label": "サイドパネル（Agent）を開閉", "mac": "Cmd+I / Cmd+L", "win": "Ctrl+I / Ctrl+L" },
      { "label": "バックグラウンドエージェントのパネル", "mac": "Cmd+E", "win": "Ctrl+E" },
      { "label": "モードメニューを開く", "mac": "Cmd+.", "win": "Ctrl+." },
      { "label": "AI モデルを順に切り替え", "mac": "Cmd+/", "win": "Ctrl+/", "note": "チャット欄にいるとき。エディタ上では行コメントの切り替えになります。" },
      { "label": "Cursor の設定", "mac": "Cmd+Shift+J", "win": "Ctrl+Shift+J" },
      { "label": "一般設定", "mac": "Cmd+,", "win": "Ctrl+," },
      { "label": "コマンドパレット", "mac": "Cmd+Shift+P", "win": "Ctrl+Shift+P" }
    ]
  },
  {
    "id": "chat",
    "title": "チャット / Agent",
    "en": "CHAT",
    "desc": "Agent とのやり取りや、提案された変更の承認・却下に使います。",
    "items": [
      { "label": "メッセージを送信", "mac": "Enter", "win": "Enter", "note": "生成中に送ると、次のメッセージとして順番待ちになります。" },
      { "label": "強制送信", "mac": "Cmd+Enter", "win": "Ctrl+Enter" },
      { "label": "生成をキャンセル", "mac": "Cmd+Shift+Backspace", "win": "Ctrl+Shift+Backspace" },
      { "label": "選択中のコードをコンテキストに追加", "mac": "Cmd+Shift+L", "win": "Ctrl+Shift+L" },
      { "label": "クリップボードの内容をコンテキストとして追加", "mac": "Cmd+V", "win": "Ctrl+V" },
      { "label": "クリップボードを入力欄にテキストで貼り付け", "mac": "Cmd+Shift+V", "win": "Ctrl+Shift+V" },
      { "label": "変更をすべて承認", "mac": "Cmd+Enter", "win": "Ctrl+Enter" },
      { "label": "変更をすべて却下", "mac": "Cmd+Backspace", "win": "Ctrl+Backspace" },
      { "label": "次のメッセージへ移動", "mac": "Tab", "win": "Tab" },
      { "label": "Agent のモードを切り替え", "mac": "Shift+Tab", "win": "Shift+Tab" },
      { "label": "モデルの切り替え", "mac": "Cmd+Opt+/", "win": "Ctrl+Alt+/" },
      { "label": "新しいチャット", "mac": "Cmd+N / Cmd+R", "win": "Ctrl+N / Ctrl+R" },
      { "label": "新しいチャットタブ", "mac": "Cmd+T", "win": "Ctrl+T" },
      { "label": "前のチャット / 次のチャット", "mac": "Cmd+[ / Cmd+]", "win": "Ctrl+[ / Ctrl+]" },
      { "label": "チャットを閉じる", "mac": "Cmd+W", "win": "Ctrl+W" },
      { "label": "入力欄からフォーカスを外す", "mac": "Esc", "win": "Esc" }
    ]
  },
  {
    "id": "inline",
    "title": "インライン編集",
    "en": "INLINE EDIT",
    "desc": "エディタ上で、選択したコードをその場で AI に書き換えてもらいます。",
    "items": [
      { "label": "インライン編集を開く", "mac": "Cmd+K", "win": "Ctrl+K" },
      { "label": "入力欄のフォーカスを切り替え", "mac": "Cmd+Shift+K", "win": "Ctrl+Shift+K" },
      { "label": "送信", "mac": "Enter", "win": "Enter" },
      { "label": "キャンセル", "mac": "Cmd+Shift+Backspace", "win": "Ctrl+Shift+Backspace" },
      { "label": "簡単な質問をする（編集せずに回答だけ受け取る）", "mac": "Opt+Enter", "win": "Alt+Enter" }
    ]
  },
  {
    "id": "context",
    "title": "コード選択とコンテキスト",
    "en": "CONTEXT",
    "desc": "AI に渡すファイルやコードを指定します。入力欄で記号を打つと候補が出ます。",
    "items": [
      { "label": "@ シンボル（ファイル・フォルダなどを参照）", "mac": "@", "win": "@" },
