      { "label": "ファイル内で置換", "mac": "Cmd+Opt+F", "win": "Ctrl+H" },
      { "label": "プロジェクト全体を検索", "mac": "Cmd+Shift+F", "win": "Ctrl+Shift+F" },
      { "label": "指定した行へ移動", "mac": "Ctrl+G", "win": "Ctrl+G" },
      { "label": "定義へ移動", "mac": "F12", "win": "F12" },
      { "label": "シンボル名を一括変更", "mac": "F2", "win": "F2" }
    ]
  },
  {
    "id": "view",
