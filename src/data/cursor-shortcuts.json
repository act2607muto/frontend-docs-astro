  {
    "id": "emmet",
    "title": "HTML / CSS で便利（Emmet）",
    "en": "EMMET",
    "desc": "Emmet は短い略記から HTML や CSS を一気に書ける機能です。Cursor にも最初から入っています。",
    "items": [
      { "label": "略記を展開（例：ul>li*3 と入力して Tab）", "mac": "Tab", "win": "Tab", "note": "Cursor の Tab 補完の提案が出ているときは、そちらが優先されます。" },
      { "label": "選択範囲をタグで囲む", "mac": "Cmd+Shift+P → Emmet: Wrap with Abbreviation", "win": "Ctrl+Shift+P → Emmet: Wrap with Abbreviation" }
    ]
