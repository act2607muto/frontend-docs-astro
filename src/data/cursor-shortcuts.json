      { "label": "ショートカットコマンド", "mac": "/", "win": "/" },
      { "label": "選択範囲をチャットに追加", "mac": "Cmd+Shift+L", "win": "Ctrl+Shift+L" },
      { "label": "選択範囲をインライン編集に追加", "mac": "Cmd+Shift+K", "win": "Ctrl+Shift+K" },
      { "label": "選択範囲を新しいチャットに追加", "mac": "Cmd+L", "win": "Ctrl+L" },
      { "label": "ファイル読み込み方式の切り替え", "mac": "Cmd+M", "win": "Ctrl+M" },
      { "label": "チャットでコードベースを検索", "mac": "Cmd+Enter", "win": "Ctrl+Enter" },
      { "label": "コピーしたコードを参照として追加", "mac": "Cmd+C → Cmd+V", "win": "Ctrl+C → Ctrl+V", "note": "コードを選択してからコピーし、チャット欄に貼り付けます。" },
      { "label": "コピーしたコードをテキストとして追加", "mac": "Cmd+C → Cmd+Shift+V", "win": "Ctrl+C → Ctrl+Shift+V" }
    ]
  },
  {
    "id": "tab",
    "title": "Tab 補完",
    "en": "TAB",
    "desc": "入力中に薄い文字で出てくる AI の提案を受け入れます。",
    "items": [
      { "label": "提案を受け入れる", "mac": "Tab", "win": "Tab" },
      { "label": "提案を単語ごとに受け入れる", "mac": "Cmd+→", "win": "Ctrl+→" },
      { "label": "提案を却下", "mac": "Esc", "win": "Esc" }
    ]
  },
  {
    "id": "terminal",
    "title": "ターミナル",
    "en": "TERMINAL",
    "desc": "ターミナルでやりたいことを日本語で書くと、コマンドを作ってくれます。",
    "items": [
      { "label": "AI プロンプトバーを開く", "mac": "Cmd+K", "win": "Ctrl+K" },
      { "label": "生成されたコマンドを実行", "mac": "Cmd+Enter", "win": "Ctrl+Enter" },
      { "label": "コマンドを受け入れる（入力欄に入れるだけ）", "mac": "Esc", "win": "Esc" }
    ]
  },
  {
    "id": "editor",
    "title": "行の編集",
    "en": "EDITOR",
    "desc": "ここからは VS Code と共通の操作です。行の移動や複製はコーディングの速さに直結します。",
    "items": [
      { "label": "行・選択範囲を上下に移動", "mac": "Opt+↑ / Opt+↓", "win": "Alt+↑ / Alt+↓" },
      { "label": "行・選択範囲を上下にコピー（複製）", "mac": "Opt+Shift+↑ / Opt+Shift+↓", "win": "Alt+Shift+↑ / Alt+Shift+↓", "note": "Linux は Ctrl+Shift+Alt+↑ / ↓" },
      { "label": "下に空行を挿入して移動", "mac": "Cmd+Enter", "win": "Ctrl+Enter" },
      { "label": "上に空行を挿入して移動", "mac": "Cmd+Shift+Enter", "win": "Ctrl+Shift+Enter" },
      { "label": "行コメントの切り替え", "mac": "Cmd+/", "win": "Ctrl+/" },
      { "label": "インデントを増やす / 減らす", "mac": "Cmd+] / Cmd+[", "win": "Ctrl+] / Ctrl+[" },
      { "label": "ドキュメントを整形", "mac": "Opt+Shift+F", "win": "Alt+Shift+F", "note": "Linux は Ctrl+Shift+I" },
      { "label": "折り返し表示の切り替え", "mac": "Opt+Z", "win": "Alt+Z" },
      { "label": "保存", "mac": "Cmd+S", "win": "Ctrl+S" }
    ]
  },
  {
    "id": "multi",
    "title": "マルチカーソル・選択",
    "en": "MULTI CURSOR",
    "desc": "複数の場所を同時に書き換えられます。同じクラス名をまとめて直したいときに便利です。",
    "items": [
      { "label": "同じ単語を次々に選択", "mac": "Cmd+D", "win": "Ctrl+D" },
      { "label": "カーソルを上下に追加", "mac": "Cmd+Opt+↑ / Cmd+Opt+↓", "win": "Ctrl+Alt+↑ / Ctrl+Alt+↓", "note": "Linux は Shift+Alt+↑ / ↓" },
      { "label": "クリックした位置にカーソルを追加", "mac": "Opt+クリック", "win": "Alt+クリック" },
      { "label": "矩形（ボックス）選択", "mac": "Opt+Shift+ドラッグ", "win": "Alt+Shift+ドラッグ" },
      { "label": "選択範囲を広げる / 狭める", "mac": "Ctrl+Shift+Cmd+→ / Ctrl+Shift+Cmd+←", "win": "Alt+Shift+→ / Alt+Shift+←" }
    ]
  },
  {
    "id": "search",
    "title": "検索・移動",
