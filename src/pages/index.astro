---
// ① トップ
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import SearchBox from '../components/SearchBox.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { order, SITE } from '../lib/data';
import { url } from '../lib/url';
import { CONFIG } from '../config';

const QUICK_COUNT = 10;

const entries = [
  { num: '01', sub: 'ROADMAP', title: '学習する', desc: '初心者・中級者・上級者の3段階で、学ぶ順番に沿って進めます。', href: url.learn() },
  { num: '02', sub: 'HTML', title: 'HTML辞典', desc: `${order.html.length}のタグを、基本構造からメディアまでカテゴリ別に。`, href: url.dict('html') },
  { num: '03', sub: 'CSS', title: 'CSS辞典', desc: `${order.css.length}のプロパティを、文字からレスポンシブまでカテゴリ別に。`, href: url.dict('css') },
  { num: '04', sub: 'JavaScript', title: 'JS辞典', desc: `${order.js.length}の構文・メソッドを、基本からDOM操作・イベントまで。`, href: url.dict('js') },
];
---
<BaseLayout title={SITE}>
  <div class="top">
    <div class="top__bar"><ThemeToggle label /></div>
    <main class="top__main">
      <div class="top__kicker">学ぶ・調べる・理解する</div>
      <h1 class="top__title">{SITE}</h1>
      <p class="top__lead">HTMLタグ・CSSプロパティ・JavaScriptを網羅した辞典と、段階的に学べるロードマップ。<br class="pc-only" />すべての項目で、コードと実際の表示結果をあわせて確認できます。</p>
      <SearchBox
        class="top__search"
        placeholder="タグ・プロパティ・やりたいことで検索（例：flex、中央寄せ）"
        emptyText="一致する項目は見つかりませんでした。別のキーワードをお試しください。"
        hint
      />
      <div class="top__quick" data-popular-url={url.api('popular-keywords')} data-defaults={JSON.stringify(CONFIG.quickWords)} data-count={QUICK_COUNT}>
        <span class="top__quick-label">よく調べるキーワード</span>
        <span class="top__quick-words">
          {CONFIG.quickWords.slice(0, QUICK_COUNT).map((w) => <button type="button" class="btn btn-ghost" data-word={w}>{w}</button>)}
        </span>
      </div>
      <nav class="top__entries" aria-label="入口">
        {entries.map((e) => (
          <a class="entry" href={e.href}>
            <span class="entry__sub"><span>{e.num} — {e.sub}</span><Icon name="arrow-right" /></span>
            <span class="entry__title">{e.title}</span>
            <span class="entry__desc">{e.desc}</span>
          </a>
        ))}
      </nav>
      <aside class="top__appendix" aria-label="付録">
        <a class="appendix-banner" href={url.cursor()}>
          <span class="appendix-banner__body">
            <span class="appendix-banner__label">APPENDIX — 付録</span>
            <span class="appendix-banner__title">Cursor ショートカット</span>
            <span class="appendix-banner__desc">AI エディタ Cursor のキー操作を Mac / Windows 別にまとめました</span>
            <span class="appendix-banner__more">一覧を見る<Icon name="arrow-right" /></span>
          </span>
          <span class="appendix-banner__keys" aria-hidden="true">
            <kbd class="kbd kbd--sym">⌘</kbd><kbd class="kbd">K</kbd>
          </span>
        </a>
      </aside>
    </main>
    <Footer left={SITE} />
  </div>
</BaseLayout>

<script>
  import { setQuery } from '../scripts/search';

  const box = document.querySelector<HTMLElement>('.top__search')!;
  const quick = document.querySelector<HTMLElement>('.top__quick')!;
  const wordsEl = quick.querySelector<HTMLElement>('.top__quick-words')!;

  quick.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLElement>('[data-word]');
    if (b) setQuery(box, b.dataset.word ?? '');
  });

  // 実際の検索履歴（Vercel の API → Supabase）からよく調べられている語句を取得し、足りない分は既定の語句で補う
  // API がない環境（GitHub Pages など）では取得に失敗するので、既定の語句のままにする
  (async () => {
    try {
      const count = Number(quick.dataset.count) || 10;
      const r = await fetch(`${quick.dataset.popularUrl}?limit=${count}`);
      if (!r.ok) return;
      const { keywords } = (await r.json()) as { keywords?: unknown };
      const popular = Array.isArray(keywords) ? keywords.filter((k): k is string => typeof k === 'string') : [];
      if (!popular.length) return;
      const defaults = JSON.parse(quick.dataset.defaults ?? '[]') as string[];
      wordsEl.replaceChildren(
        ...[...new Set([...popular, ...defaults])].slice(0, count).map((w) => {
          const b = document.createElement('button');
          b.type = 'button';
          b.className = 'btn btn-ghost';
          b.dataset.word = w;
          b.textContent = w;
          return b;
        }),
      );
    } catch { /* 取得できなくても既定の語句のまま */ }
  })();
</script>
